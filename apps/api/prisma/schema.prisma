generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  OWNER
  EMPLOYEE
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Domain-only for now (see Payment model doc comment): no gateway is wired up yet, so
// these just describe how the money moved, recorded after the fact.
enum PaymentMethod {
  CASH
  CARD
  MULTICAIXA
  BANK_TRANSFER
  OTHER
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  name              String
  phone             String?
  role              Role      @default(CUSTOMER)
  avatarUrl         String?
  // The last position the app reported for this user (GPS, with their permission). Kept
  // so distances to businesses can be computed when no fresh reading is available.
  latitude          Float?
  longitude         Float?
  locationUpdatedAt DateTime?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  ownedBusinesses     Business[]       @relation("BusinessOwner")
  professionalProfile Professional?
  appointments        Appointment[]    @relation("AppointmentClient")
  refreshTokens       RefreshToken[]
  favorites           Favorite[]
  reviews             Review[]
  clientOf            BusinessClient[]
  notifications       Notification[]
  pushTokens          PushToken[]
  payments            Payment[]
  loyaltyMemberships  LoyaltyMember[]

  // Optional, given by the client: lets the spaces they are members of offer a birthday reward.
  birthDate        DateTime? @db.Date
  // Whether spaces may send them promotions and campaigns (points and rewards always arrive).
  notifyPromotions Boolean   @default(true)

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Business {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation("BusinessOwner", fields: [ownerId], references: [id])
  name        String
  description String?
  address     String?
  phone       String?
  category    String?
  // The gallery cover (what the app's lists show when there is no logo).
  imageUrl    String?
  // The logo picked in the dashboard's Configurações. Separate from imageUrl so gallery
  // changes never replace it.
  logoUrl     String?
  latitude    Float?
  longitude   Float?
  // The region the pin falls in, as OpenStreetMap names it — stored when the owner marks
  // the location, so searching by locality never has to geocode anything.
  provincia   String?
  municipio   String?
  distrito    String?
  bairro      String?
  rua         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  professionals    Professional[]
  services         Service[]
  appointments     Appointment[]
  favorites        Favorite[]
  reviews          Review[]
  clients          BusinessClient[]
  hours            BusinessHours[]
  payments         Payment[]
  galleryImages    GalleryImage[]
  walkInClients    WalkInClient[]
  loyaltyProgram   LoyaltyProgram?
  loyaltyMembers   LoyaltyMember[]
  loyaltyBenefits  LoyaltyBenefit[]
  loyaltyRewards   LoyaltyReward[]
  promotions       Promotion[]
  loyaltyAuditLogs LoyaltyAuditLog[]

  @@index([ownerId])
  @@index([provincia, bairro])
  @@map("businesses")
}

// A customer the business knows offline (walk-in, phone booking) who has no account of
// their own — as opposed to a User with role CUSTOMER, who books through the app.
// Appointment/Payment can point at either one, never both (enforced in the service layer,
// not the DB, same as the rest of this schema's cross-field invariants).
model WalkInClient {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  email      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  appointments Appointment[]
  payments     Payment[]

  @@index([businessId])
  @@map("walk_in_clients")
}

// url is the public URL served to clients; path is the object key inside the storage
// bucket, kept so a delete can remove the underlying file, not just this row.
model GalleryImage {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  url        String
  path       String
  position   Int      @default(0)
  caption    String?
  createdAt  DateTime @default(now())

  @@index([businessId, position])
  @@map("gallery_images")
}

// One row per open window; a day with no rows is closed, and a day can have several
// rows (e.g. 09:00-13:00 + 14:00-18:00) to represent a lunch break as a gap.
model BusinessHours {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek   Int // 0 = Sunday .. 6 = Saturday
  startMinute Int // minutes since midnight, e.g. 540 = 09:00
  endMinute   Int // e.g. 1080 = 18:00
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId, dayOfWeek])
  @@map("business_hours")
}

model Professional {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  bio        String?
  specialty  String?
  imageUrl   String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  appointments Appointment[]
  blocks       ProfessionalBlock[]

  @@index([businessId])
  @@map("professionals")
}

// Time off / vacation / anything that takes a professional out of availability
// without cancelling actual appointments (those are already excluded separately).
model ProfessionalBlock {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  startAt        DateTime     @db.Timestamptz(3)
  endAt          DateTime     @db.Timestamptz(3)
  reason         String?
  createdAt      DateTime     @default(now())

  @@index([professionalId, startAt])
  @@map("professional_blocks")
}

model Service {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  duration    Int
  category    String?
  imageUrl    String?
  active      Boolean  @default(true)
  // Only members of the space's loyalty programme can book it (checked when booking).
  membersOnly Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]
  promotions   PromotionService[]
  rewards      LoyaltyRewardService[]

  @@index([businessId])
  @@map("services")
}

model Appointment {
  id              String            @id @default(uuid())
  businessId      String
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Exactly one of clientId/walkInClientId is set: clientId for a self-service booking
  // by a logged-in CUSTOMER, walkInClientId for one entered by the business on behalf of
  // someone without an account. Enforced in appointments.service, not the DB.
  clientId        String?
  client          User?             @relation("AppointmentClient", fields: [clientId], references: [id])
  walkInClientId  String?
  walkInClient    WalkInClient?     @relation(fields: [walkInClientId], references: [id])
  serviceId       String
  service         Service           @relation(fields: [serviceId], references: [id])
  professionalId  String
  professional    Professional      @relation(fields: [professionalId], references: [id])
  scheduledAt     DateTime          @db.Timestamptz(3)
  durationMinutes Int
  // `price` is what the client pays (after discounts); originalPrice is the service's price
  // at booking time. Both are set by the server — never taken from the request.
  price           Decimal           @db.Decimal(10, 2)
  originalPrice   Decimal?          @db.Decimal(10, 2)
  discountTotal   Decimal           @default(0) @db.Decimal(10, 2)
  status          AppointmentStatus @default(PENDING)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  review              Review?
  payment             Payment?
  discounts           AppointmentDiscount[]
  promotionUsages     PromotionUsage[]
  memberRewards       MemberReward[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([businessId])
  @@index([clientId])
  @@index([walkInClientId])
  @@index([professionalId, scheduledAt])
  @@map("appointments")
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("favorites")
}

// An app user who chose to be a client of a business (asked when they book there). Booking
// alone does not make someone a client: they can decline and still book. Their name,
// phone, email and photo come from their own account, so they stay up to date.
model BusinessClient {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_clients")
}

model Review {
  id            String      @id @default(uuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId      String
  client        User        @relation(fields: [clientId], references: [id])
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([businessId])
  @@map("reviews")
}

// One payment per appointment (appointmentId is unique): a PENDING payment moves through
// PAID/FAILED/REFUNDED as status transitions rather than spawning new rows, so the
// original record — and its history — is never lost. amount/currency/userId/businessId
// are always derived server-side from the appointment; never accept them from a client.
model Payment {
  id             String        @id @default(uuid())
  appointmentId  String        @unique
  appointment    Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  // Mirrors Appointment: exactly one of userId/walkInClientId is set, matching whichever
  // one the paid appointment itself used.
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  walkInClientId String?
  walkInClient   WalkInClient? @relation(fields: [walkInClientId], references: [id])
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("AOA")
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?     @db.Timestamptz(3)
  proof          PaymentProof?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([businessId])
  @@map("payments")
}

// The proof of a transfer / Multicaixa Express payment (a photo or PDF the client sent the
// staff), attached when the payment is received. Its own table so listing payments never
// loads the file. The file lives in the private proofs bucket (`path`); without Supabase
// configured it is kept in `data` instead and `path` is null. Never served by a public URL:
// it carries bank details, so it is read back only through GET /payments/:id/proof.
model PaymentProof {
  id           String   @id @default(uuid())
  paymentId    String   @unique
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  size         Int
  path         String?
  data         Bytes?
  uploadedById String
  createdAt    DateTime @default(now())

  @@map("payment_proofs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

// The Expo push token of each phone where the user is signed in to the app: every
// notification is also sent there, with sound.
model PushToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_tokens")
}

/**
 * =========================================================================
 * FIDELIZAÇÃO, BENEFÍCIOS E PROMOÇÕES
 * Everything here belongs to one business (businessId on every row), so one space can
 * never see or change another's programme. A client's membership is per business: being
 * a member of one space says nothing about any other. Joining is free for now; `plan`
 * on LoyaltyMember is where paid VIP plans would hang later.
 * =========================================================================
 */

enum LoyaltyMemberStatus {
  ACTIVE
  SUSPENDED // by the business: no member prices or rewards until reactivated
  REMOVED // by the business: cannot rejoin on their own
  LEFT // the client left; may join again
}

enum LoyaltyTransactionType {
  EARN // points for a paid appointment
  REDEEM // points spent on a reward
  REFUND // points of a cancelled redemption given back
  REVERSAL // points of a refunded payment taken back
  EXPIRE // points past their validity
  ADJUST // a manual correction by the owner (positive or negative)
}

enum DiscountType {
  PERCENT // value = 0..100
  AMOUNT // value = Kz off
  FREE // the service costs nothing
}

enum PromotionAudience {
  ALL
  MEMBERS
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum LoyaltyRewardKind {
  POINTS // bought with points when booking
  VISITS // unlocked after N paid appointments in the eligible services
  BIRTHDAY // given in the member's birthday month
}

enum MemberRewardStatus {
  AVAILABLE
  RESERVED // held by an upcoming appointment
  USED
  EXPIRED
  CANCELLED // bought with points for an appointment that was cancelled: the points went back
}

enum DiscountUsageStatus {
  RESERVED // the appointment is booked
  CONSUMED // the appointment was paid
  RELEASED // the appointment was cancelled / not attended: the slot is free again
}

model LoyaltyProgram {
  id          String   @id @default(uuid())
  businessId  String   @unique
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Off until the owner turns it on: the app shows nothing for a space without a programme.
  active      Boolean  @default(false)
  name        String
  description String?
  // Shown before joining: who can join and what is expected.
  joinRules   String?
  terms       String?

  pointsEnabled    Boolean @default(false)
  // `pointsPerUnit` points for every `amountPerUnit` Kz paid (e.g. 10 per 1000 Kz).
  pointsPerUnit    Int     @default(10)
  amountPerUnit    Int     @default(1000)
  // Points expire this many days after being earned; null = never.
  pointsExpireDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("loyalty_programs")
}

model LoyaltyMember {
  id              String              @id @default(uuid())
  businessId      String
  business        Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          LoyaltyMemberStatus @default(ACTIVE)
  plan            String              @default("FREE")
  // Only ever changed together with a LoyaltyTransaction row, in one transaction with the
  // member row locked (see loyalty.repository) — the ledger is the source of truth.
  pointsBalance   Int                 @default(0)
  joinedAt        DateTime            @default(now())
  statusChangedAt DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  transactions LoyaltyTransaction[]
  rewards      MemberReward[]
  events       LoyaltyMemberEvent[]

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId, status])
  @@map("loyalty_members")
}

// The membership's history: joined, suspended, reactivated, removed, left.
model LoyaltyMemberEvent {
  id        String        @id @default(uuid())
  memberId  String
  member    LoyaltyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  action    String
  reason    String?
  actorId   String?
  createdAt DateTime      @default(now())

  @@index([memberId, createdAt])
  @@map("loyalty_member_events")
}

model LoyaltyTransaction {
  id             String                 @id @default(uuid())
  memberId       String
  member         LoyaltyMember          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  businessId     String
  type           LoyaltyTransactionType
  // Signed: positive adds to the balance, negative takes from it.
  points         Int
  balanceAfter   Int
  appointmentId  String?
  appointment    Appointment?           @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  memberRewardId String?
  reason         String?
  actorId        String?
  // EARN rows only: when these points stop counting.
  expiresAt      DateTime?              @db.Timestamptz(3)
  // One row per real-world event ("earn:<appointmentId>", …): a repeated request or
  // notification can never award or take the same points twice.
  idempotencyKey String                 @unique
  createdAt      DateTime               @default(now())

  @@index([memberId, createdAt])
  @@index([businessId, createdAt])
  @@map("loyalty_transactions")
}

// What the space says members get (priority service, early access…). The mechanics with
// money attached are promotions and rewards; these are the promises shown around them.
model LoyaltyBenefit {
  id          String    @id @default(uuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title       String
  description String?
  conditions  String?
  validFrom   DateTime? @db.Timestamptz(3)
  validUntil  DateTime? @db.Timestamptz(3)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([businessId])
  @@map("loyalty_benefits")
}

model LoyaltyReward {
  id             String            @id @default(uuid())
  businessId     String
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  kind           LoyaltyRewardKind
  pointsCost     Int?
  visitsRequired Int?
  discountType   DiscountType
  discountValue  Decimal           @default(0) @db.Decimal(10, 2)
  // Unlocked rewards (VISITS/BIRTHDAY) can be used for this many days; null = no limit.
  validDays      Int?
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Empty = every service of the space.
  services      LoyaltyRewardService[]
  memberRewards MemberReward[]

  @@index([businessId])
  @@map("loyalty_rewards")
}

model LoyaltyRewardService {
  rewardId  String
  reward    LoyaltyReward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([rewardId, serviceId])
  @@index([serviceId])
  @@map("loyalty_reward_services")
}

// A reward a member has (unlocked, or bought with points for one appointment).
model MemberReward {
  id               String             @id @default(uuid())
  memberId         String
  member           LoyaltyMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  rewardId         String
  reward           LoyaltyReward      @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  businessId       String
  status           MemberRewardStatus @default(AVAILABLE)
  appointmentId    String?
  appointment      Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  expiresAt        DateTime?          @db.Timestamptz(3)
  // "visits:<rewardId>:<memberId>:<n>", "birthday:<rewardId>:<memberId>:<year>", "points:<appointmentId>"
  unlockKey        String             @unique
  expiryNotifiedAt DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([memberId, status])
  @@index([businessId])
  @@map("member_rewards")
}

model Promotion {
  id               String            @id @default(uuid())
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  audience         PromotionAudience @default(ALL)
  status           PromotionStatus   @default(DRAFT)
  discountType     DiscountType
  discountValue    Decimal           @default(0) @db.Decimal(10, 2)
  startsAt         DateTime?         @db.Timestamptz(3)
  endsAt           DateTime?         @db.Timestamptz(3)
  // Members may use it from this moment (early access), before startsAt opens it to everyone.
  membersFrom      DateTime?         @db.Timestamptz(3)
  // ISO weekdays 1 (Monday) … 7 (Sunday); empty = every day.
  weekdays         Int[]             @default([])
  // Minutes after midnight (app time zone) the appointment must start in; null = any time.
  startMinute      Int?
  endMinute        Int?
  // Total uses (the "20 promotional haircuts"); null = no limit. Cancelled bookings give
  // the use back.
  maxUses          Int?
  maxUsesPerClient Int?
  stackable        Boolean           @default(false)
  // Campaign rule: a cancelled (or missed) booking gives its use back to the campaign.
  releaseOnCancel  Boolean           @default(true)
  notifiedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Empty = every service of the space.
  services PromotionService[]
  usages   PromotionUsage[]

  @@index([businessId, status])
  @@map("promotions")
}

model PromotionService {
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([promotionId, serviceId])
  @@index([serviceId])
  @@map("promotion_services")
}

model PromotionUsage {
  id             String              @id @default(uuid())
  promotionId    String
  promotion      Promotion           @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  appointmentId  String
  appointment    Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  userId         String?
  walkInClientId String?
  status         DiscountUsageStatus @default(RESERVED)
  discountAmount Decimal             @db.Decimal(10, 2)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([promotionId, appointmentId])
  @@index([promotionId, status])
  @@index([appointmentId])
  @@map("promotion_usages")
}

// Each discount an appointment got, and where it came from — the receipt of its price.
model AppointmentDiscount {
  id             String      @id @default(uuid())
  appointmentId  String
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  source         String // "PROMOTION" | "REWARD"
  promotionId    String?
  memberRewardId String?
  label          String
  amount         Decimal     @db.Decimal(10, 2)
  createdAt      DateTime    @default(now())

  @@index([appointmentId])
  @@map("appointment_discounts")
}

// What the owner changed in the programme, members, promotions and rewards.
model LoyaltyAuditLog {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actorId    String
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@map("loyalty_audit_logs")
}
